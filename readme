 🧪 Postman Testing Examples
1. Register & Login
javascript// POST http://localhost:5000/api/auth/register
{
  "username": "admin",
  "email": "admin@coffee.com",
  "password": "admin123",
  "fullName": "Admin User",
  "phone": "+855 12 345 678",
  "role": "admin",
  "hourlyRate": 5
}

// POST http://localhost:5000/api/auth/login
{
  "username": "admin",
  "password": "admin123"
}
// Response: { "token": "...", "user": {...} }
// Save token for subsequent requests
2. Create Category
javascript// POST http://localhost:5000/api/products/categories
// Headers: Authorization: Bearer YOUR_TOKEN
{
  "name": "Coffee",
  "description": "Hot and cold coffee drinks",
  "type": "coffee",
  "displayOrder": 1
}
3. Create Product
javascript// POST http://localhost:5000/api/products
// Headers: Authorization: Bearer YOUR_TOKEN
{
  "name": "Cappuccino",
  "description": "Classic Italian coffee with steamed milk",
  "category": "CATEGORY_ID_HERE",
  "price": 4.50,
  "sizes": [
    { "name": "Small", "price": 3.50 },
    { "name": "Medium", "price": 4.50 },
    { "name": "Large", "price": 5.50 }
  ],
  "customizations": [
    {
      "name": "Sugar Level",
      "options": [
        { "name": "No Sugar", "priceModifier": 0 },
        { "name": "Less Sugar", "priceModifier": 0 },
        { "name": "Normal", "priceModifier": 0 },
        { "name": "Extra Sweet", "priceModifier": 0.50 }
      ]
    }
  ],
  "isAvailable": true,
  "preparationTime": 5
}
4. Create Customer
javascript// POST http://localhost:5000/api/customers
// Headers: Authorization: Bearer YOUR_TOKEN
{
  "name": "John Doe",
  "phone": "+855 12 999 888",
  "email": "john@example.com",
  "birthDate": "1990-05-15"
}
5. Create Order
javascript// POST http://localhost:5000/api/orders
// Headers: Authorization: Bearer YOUR_TOKEN
{
  "type": "dine_in",
  "items": [
    {
      "product": "PRODUCT_ID_HERE",
      "quantity": 2,
      "size": "Medium",
      "customizations": [
        {
          "name": "Sugar Level",
          "option": "Less Sugar",
          "priceModifier": 0
        }
      ]
    }
  ],
  "customer": "CUSTOMER_ID_HERE",
  "discount": {
    "type": "percentage",
    "value": 10
  },
  "notes": "Extra hot please"
}
6. Process Payment
javascript// POST http://localhost:5000/api/payments
// Headers: Authorization: Bearer YOUR_TOKEN
{
  "orderId": "ORDER_ID_HERE",
  "method": "cash",
  "amount": 10.00,
  "cashReceived": 20.00
}
7. Create Table
javascript// POST http://localhost:5000/api/tables
// Headers: Authorization: Bearer YOUR_TOKEN
{
  "tableNumber": "T01",
  "seats": 4,
  "floor": "Ground Floor",
  "section": "Main Dining",
  "position": {
    "x": 100,
    "y": 150
  }
}
